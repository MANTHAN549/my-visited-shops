# ---------------------------------------------------------------------------
# Build / deployment configuration
# ---------------------------------------------------------------------------
# Public base path. Leave as "/" for a root domain, or set to the repository
# name (with leading and trailing slashes) for GitHub Pages project sites.
#   VITE_BASE_PATH=/my-visited-shops/
VITE_BASE_PATH=/

# ---------------------------------------------------------------------------
# Optional runtime defaults (all of these are also editable in Settings UI)
# ---------------------------------------------------------------------------
# OSRM-compatible routing endpoint. Must expose /route/v1/{profile}/{coords}
VITE_OSRM_BASE_URL=https://router.project-osrm.org

# Nominatim-compatible geocoding endpoint. Reverse geocoding stays DISABLED
# in the UI by default; enabling it sends coordinates to the provider.
VITE_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# OpenStreetMap raster tile template (attribution is rendered on the map).
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

